    },
    {
      "parameters": {
        "jsCode": "// Pega os produtos vindos do 3º nó (Code in JavaScript)\nconst produtos = $items(\"Code in JavaScript\").map(item => item.json);\n\n// Pega os dados dos clientes vindos do 5º nó (HTML)\nconst htmlData = $items(\"HTML\")[0].json;\nconst nomes = htmlData.nome || [];\nconst emails = htmlData.email || [];\nconst saldos = htmlData.saldo || [];\nconst perfis = htmlData.perfil || [];\n\nconst recomendacoes = [];\n\n// Cruza os clientes com as opções de investimento do seu perfil\nfor (let i = 0; i < nomes.length; i++) {\n  const perfilCliente = perfis[i];\n  \n  const opcoesRecomendadas = produtos.filter(p => p.perfil.toLowerCase() === perfilCliente.toLowerCase());\n\n  recomendacoes.push({\n    json: {\n      cliente: nomes[i],\n      email: emails[i],\n      saldo: saldos[i],\n      perfil: perfilCliente,\n      recomendacoes: opcoesRecomendadas\n    }\n  });\n}\n\nreturn recomendacoes;"
      },
