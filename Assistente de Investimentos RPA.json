    {
      "parameters": {
        "jsCode": "// Pega o texto cru do CSV que veio do nó anterior\nconst csvText = $input.item.json.data;\n\n// Divide o texto em linhas e separa o cabeçalho\nconst lines = csvText.trim().split('\\n');\nconst headers = lines[0].split(',');\n\nconst outputItems = [];\n\n// Converte cada linha do CSV em um objeto JSON estruturado\nfor (let i = 1; i < lines.length; i++) {\n  const currentLine = lines[i].split(',');\n  const obj = {};\n  for (let j = 0; j < headers.length; j++) {\n    obj[headers[j].trim()] = currentLine[j] ? currentLine[j].trim() : '';\n  }\n  outputItems.push({ json: obj });\n}\n\nreturn outputItems;"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -512,
        0
      ],
      "id": "fb503814-152b-43e3-8850-d0401288fbfc",
